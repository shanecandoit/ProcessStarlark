{
  "title": "Answer a shipping question in an isolated draft",
  "reference": "examples/shipping",
  "steps": [
    {
      "title": "Create a draft from the unchanged reference",
      "method": "POST",
      "path": "/api/v1/drafts",
      "body": {
        "id": "{draft}",
        "name": "Add Germany shipping",
        "author": "ops"
      },
      "expect": {
        "status": 201,
        "json": {
          "/draft/created_by": "ops"
        }
      },
      "capture": {
        "state": "/draft/state_token",
        "root": "/draft/revision",
        "source": "/draft/source_revision"
      }
    },
    {
      "title": "Ask for a quote; Park needs Germany's zone",
      "method": "POST",
      "path": "/api/v1/drafts/{draft}/operations",
      "body": {
        "author": "ops",
        "operation": {
          "kind": "run",
          "call": "Shipping.quote(\"DE\", 800)"
        },
        "expected_state": "{state}"
      },
      "expect": {
        "status": 200,
        "json": {
          "/result/status": "unresolved",
          "/draft/snapshot/questions/0/function": "Zones.zone",
          "/draft/snapshot/questions/0/input/country": "\"DE\"",
          "/draft/revision": "{root}",
          "/draft/source_revision": "{source}"
        }
      },
      "capture": {
        "state": "/draft/state_token",
        "stale_state": "/draft/state_token"
      }
    },
    {
      "title": "Save Germany's zone as an example",
      "method": "POST",
      "path": "/api/v1/drafts/{draft}/operations",
      "body": {
        "author": "ops",
        "operation": {
          "kind": "add-example",
          "example": "Zones.zone(\"DE\") == \"international\""
        },
        "expected_state": "{state}"
      },
      "expect": {
        "status": 200,
        "json": {
          "/result/status": "ok",
          "/draft/snapshot/questions": []
        }
      },
      "capture": {
        "state": "/draft/state_token",
        "head": "/draft/revision"
      }
    },
    {
      "title": "Rerun the quote using the new answer",
      "method": "POST",
      "path": "/api/v1/drafts/{draft}/operations",
      "body": {
        "author": "ops",
        "operation": {
          "kind": "run",
          "call": "Shipping.quote(\"DE\", 800)"
        },
        "expected_state": "{state}"
      },
      "expect": {
        "status": 200,
        "json": {
          "/result/status": "ok",
          "/result/output": "2799",
          "/draft/revision": "{head}"
        }
      },
      "capture": {
        "state": "/draft/state_token"
      }
    },
    {
      "title": "Check every implemented rule against its examples",
      "method": "POST",
      "path": "/api/v1/drafts/{draft}/operations",
      "body": {
        "author": "developer",
        "operation": {
          "kind": "test"
        },
        "expected_state": "{state}"
      },
      "expect": {
        "status": 200,
        "json": {
          "/result/status": "ok",
          "/draft/revision": "{head}"
        }
      },
      "capture": {
        "state": "/draft/state_token"
      }
    },
    {
      "title": "Review changed source and affected function versions",
      "method": "GET",
      "path": "/api/v1/drafts/{draft}/diff",
      "expect": {
        "status": 200,
        "json": {
          "/files_changed": [
            "zones.star"
          ],
          "/files_deleted": [],
          "/function_changes/0/qualified": "Shipping.quote",
          "/function_changes/1/qualified": "Zones.zone",
          "/function_changes/1/examples_added": 1,
          "/function_changes/1/body_changed": false,
          "/draft_revision": "{head}"
        }
      }
    },
    {
      "title": "Inspect immutable source versions and their parent links",
      "method": "GET",
      "path": "/api/v1/drafts/{draft}/versions",
      "expect": {
        "status": 200,
        "json": {
          "/versions/0/id": "{head}",
          "/versions/0/parent": "{root}",
          "/versions/1/id": "{root}",
          "/versions/1/parent": ""
        }
      }
    },
    {
      "title": "Reject a stale edit; keep the reviewed draft unchanged",
      "method": "POST",
      "path": "/api/v1/drafts/{draft}/operations",
      "body": {
        "author": "other-editor",
        "operation": {
          "kind": "add-example",
          "example": "Zones.zone(\"JP\") == \"international\""
        },
        "expected_state": "{stale_state}"
      },
      "expect": {
        "status": 409,
        "json": {
          "/draft/revision": "{head}"
        }
      }
    },
    {
      "title": "Read the operation history without changing the draft",
      "method": "GET",
      "path": "/api/v1/drafts/{draft}?history=true",
      "expect": {
        "status": 200,
        "json": {
          "/draft/history/0/author": "ops",
          "/draft/history/3/author": "developer",
          "/draft/snapshot/questions": [],
          "/draft/revision": "{head}"
        }
      }
    },
    {
      "title": "Check that the reference source is still unchanged",
      "method": "GET",
      "path": "/api/v1/base",
      "expect": {
        "status": 200,
        "json": {
          "/snapshot/questions": [],
          "/snapshot/valid": true
        },
        "reference_unchanged": true
      }
    },
    {
      "title": "Export a normal Park project before stopping the service",
      "method": "GET",
      "path": "/api/v1/drafts/{draft}/export",
      "expect": {
        "status": 200,
        "archive_member": "park-project/zones.star",
        "archive_contains": "zone(\"DE\")"
      }
    }
  ]
}
